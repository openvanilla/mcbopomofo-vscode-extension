{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "McBopomofo Data",
  "scopeName": "source.mcbopomofo-data",
  "patterns": [
    {
      "name": "comment.line.number-sign.mcbopomofo-data",
      "match": "^#.*$"
    },
    {
      "name": "meta.data-line.mcbopomofo-data",
      "begin": "^(?=\\S+\\s+(?:[ㄅㄆㄇㄈㄉㄊㄋㄌㄍㄎㄏㄐㄑㄒㄓㄔㄕㄖㄗㄘㄙㄚㄛㄜㄝㄞㄟㄠㄡㄢㄣㄤㄥㄦㄧㄨㄩ˙ˊˇˋ]+(?:-[ㄅㄆㄇㄈㄉㄊㄋㄌㄍㄎㄏㄐㄑㄒㄓㄔㄕㄖㄗㄘㄙㄚㄛㄜㄝㄞㄟㄠㄡㄢㄣㄤㄥㄦㄧㄨㄩ˙ˊˇˋ]+)*|_\\S+)$)(\\S+)(\\s+)",
      "beginCaptures": {
        "1": { "name": "string.unquoted.mcbopomofo-data" },
        "2": { "name": "punctuation.separator.mcbopomofo-data" }
      },
      "end": "$",
      "patterns": [
        {
          "match": "-",
          "name": "keyword.operator.hyphen.mcbopomofo-data"
        },
        {
          "match": "[ㄅㄆㄇㄈㄉㄊㄋㄌㄍㄎㄏㄐㄑㄒㄓㄔㄕㄖㄗㄘㄙㄚㄛㄜㄝㄞㄟㄠㄡㄢㄣㄤㄥㄦㄧㄨㄩ˙ˊˇˋ]+",
          "name": "entity.name.function.mcbopomofo-data"
        },
        {
          "match": "_\\S+",
          "name": "entity.name.function.mcbopomofo-data"
        }
      ]
    },
    {
      "name": "invalid.illegal.mcbopomofo-data",
      "match": "^(?!#|\\s*$).+$"
    }
  ],
  "repository": {}
}
